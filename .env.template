# Willow v6 Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# API Keys for LLM Providers (optional)
# OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here  
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Logging Configuration
# WILLOW_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Model Configuration
# WILLOW_DEFAULT_TIMEOUT=15
# WILLOW_PRIMARY_TIMEOUT=90
# WILLOW_MAX_PROMPT_LENGTH=50000

# Security Settings
# WILLOW_ENABLE_TELEMETRY=false
# WILLOW_MAX_SUBPROCESS_TIMEOUT=30